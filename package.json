{
  "name": "168-audit",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive 168-hour weekly audit — plan an ideal week, log your actual week, compare and export.",
  "main": "server.ts",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node server.ts",
    "dev": "node server.ts",
    "test:schema": "node tests/verify-schema.mts",
    "test:cloud-ui": "node tests/verify-cloud-ui.mts",
    "test:overview": "node tests/verify-overview.mts",
    "test:supabase-live": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/run-supabase-live.ps1",
    "test:supabase-ui-live": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/run-supabase-ui-live.ps1",
    "test:live": "node tests/verify-live.mts",
    "test:local": "node tests/verify-live.mts http://localhost:3168"
  },
  "dependencies": {
    "@fontsource-variable/rethink-sans": "5.3.0",
    "@supabase/supabase-js": "2.57.4",
    "express": "4.22.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@types/express": "5.0.5",
    "@types/node": "24.9.2",
    "playwright": "1.60.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
