# Browser-safe runtime configuration
SUPABASE_URL=https://your-disposable-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Live verification only. The launcher reads SUPABASE_ACCESS_TOKEN directly
# from Windows User scope and injects it into one child process.
SUPABASE_ACCESS_TOKEN=store-in-windows-user-environment
LIVE_SUPABASE_PROJECT_REF=your-disposable-project-ref
